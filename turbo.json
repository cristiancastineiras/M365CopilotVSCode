{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      // Sólo lo que genera cada paquete dentro de sí mismo: dist/** (core y
      // VS Code) y el userscript que genera el build de VS Code. WXT saca el
      // suyo a releases/chrome, y eso lo declara extensiones/browser/turbo.json.
      // Antes estaba aquí `../../releases/**` para TODOS los paquetes, y un
      // build sacado de caché (el del core, p. ej.) restauraba la carpeta
      // releases/ entera tal como estaba al cachearse: volvían .vsix viejos.
      "outputs": ["dist/**", ".output/**", "*.user.js"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    // Empaquetar es el paso de release: siempre de cero, nunca de caché (una
    // caché de releases/ volvería a traer los artefactos de otra versión).
    "package": {
      "dependsOn": ["build"],
      "cache": false
    },
    "zip": {
      "dependsOn": ["build"],
      "cache": false
    }
  }
}
