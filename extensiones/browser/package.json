{
  "name": "m365-copilot-vscode-extension",
  "version": "1.0.2",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox -c wxt.config.firefox.ts",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox -c wxt.config.firefox.ts",
    "typecheck": "tsc --noEmit",
    "zip": "wxt zip && node scripts/rename-zip.mjs ../../releases/chrome chrome m365-copilot-vscode-extension-chrome.zip",
    "zip:firefox": "wxt zip -b firefox -c wxt.config.firefox.ts && node scripts/rename-zip.mjs ../../releases/firefox firefox m365-copilot-vscode-extension-firefox.zip",
    "postinstall": "wxt prepare",
    "test": "node --experimental-strip-types test/refreshPolicy.mts && node --experimental-strip-types --import ./test/register.mjs test/refreshCycle.mts"
  },
  "dependencies": {
    "@m365copilot/core": "workspace:*",
    "wxt": "^0.21.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.6.2",
    "vite": "^8.2.2"
  }
}
