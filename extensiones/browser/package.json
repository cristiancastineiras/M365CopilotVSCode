{
  "name": "m365-copilot-vscode-extension",
  "version": "1.3.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "typecheck": "tsc --noEmit",
    "zip": "wxt zip && node -e \"require('fs').renameSync('../../releases/chrome/m365-copilot-vscode-extension-0.0.1-chrome.zip', '../../releases/chrome/m365-copilot-vscode-extension-chrome.zip')\"",
    "zip:firefox": "wxt zip -b firefox -c wxt.config.firefox.ts && node -e \"require('fs').renameSync('../../releases/firefox/m365-copilot-vscode-extension-0.0.1-firefox.zip', '../../releases/firefox/m365-copilot-vscode-extension-firefox.zip')\"",
    "postinstall": "wxt prepare",
    "test": "node --experimental-strip-types test/refreshPolicy.mts && node --experimental-strip-types --import ./test/register.mjs test/refreshCycle.mts"
  },
  "dependencies": {
    "@ms365copilot/core": "workspace:*",
    "wxt": "^0.19.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.6.2",
    "vite": "^6.0.0",
    "rolldown": "^0.12.0"
  }
}
