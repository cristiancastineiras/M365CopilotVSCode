      },
      {
        "command": "ms365copilot.previousChange",
        "title": "%command.previousChange%",
        "category": "M365 Copilot",
        "icon": "$(arrow-up)"
      },
      {
        "command": "ms365copilot.nextChange",
        "title": "%command.nextChange%",
        "category": "M365 Copilot",
        "icon": "$(arrow-down)"
      },
      {
        "command": "ms365copilot.keepHunk",
        "title": "%command.keepHunk%",
        "category": "M365 Copilot",
        "icon": "$(check)"
      },
      {
        "command": "ms365copilot.undoHunk",
        "title": "%command.undoHunk%",
        "category": "M365 Copilot",
        "icon": "$(discard)"
      },
      {
        "command": "ms365copilot.discardPendingEdits",
        "title": "%command.discardPendingEdits%",
        "category": "M365 Copilot"
      },
      {
        "command": "ms365copilot.undoLastAgentEdit",
        "title": "%command.undoLastAgentEdit%",
        "category": "M365 Copilot"
      }
    ],
    "chatParticipants": [
      {
        "id": "ms365copilot.m365",
        "name": "m365",
        "fullName": "M365 Copilot",
        "description": "%participant.description%",
        "isSticky": true,
        "commands": [
          {
            "name": "explain",
            "description": "%participant.command.explain%"
          },
          {
            "name": "fix",
            "description": "%participant.command.fix%"
          },
          {
            "name": "doc",
            "description": "%participant.command.doc%"
          },
          {
            "name": "tests",
            "description": "%participant.command.tests%"
          },
          {
            "name": "terminal",
            "description": "%participant.command.terminal%"
          }
        ]
      }
    ],
    "submenus": [
      {
        "id": "ms365copilot.editor",
        "label": "M365 Copilot"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "ms365copilot.editor",
          "group": "ms365copilot@1",
          "when": "editorTextFocus"
        }
      ],
      "ms365copilot.editor": [
        {
          "command": "ms365copilot.editCode",
          "group": "0_edit@1",
          "when": "!editorReadonly"
        },
        {
          "command": "ms365copilot.explainCode",
          "group": "1_ask@1"
        },
        {
          "command": "ms365copilot.askAboutCode",
          "group": "1_ask@2"
        },
        {
          "command": "ms365copilot.fixCode",
          "group": "2_change@1",
          "when": "!editorReadonly"
        },
        {
          "command": "ms365copilot.documentCode",
          "group": "2_change@2",
          "when": "!editorReadonly"
        },
        {
          "command": "ms365copilot.generateTests",
          "group": "2_change@3"
        }
      ],
      "editor/title": [
        {
          "command": "ms365copilot.previousChange",
          "group": "navigation@1",
          "when": "ms365copilot.activeEditorHasPendingEdits"
        },
        {
          "command": "ms365copilot.nextChange",
          "group": "navigation@2",
          "when": "ms365copilot.activeEditorHasPendingEdits"
        },
        {
          "command": "ms365copilot.keepEdits",
          "group": "navigation@3",
          "when": "ms365copilot.activeEditorHasPendingEdits"
        },
        {
          "command": "ms365copilot.undoEdits",
          "group": "navigation@4",
          "when": "ms365copilot.activeEditorHasPendingEdits"
        },
        {
          "command": "ms365copilot.showEditDiff",
          "group": "navigation@5",
          "when": "ms365copilot.activeEditorHasPendingEdits"
        }
      ],
      "scm/title": [
        {
          "command": "ms365copilot.generateCommitMessage",
          "group": "navigation@10",
          "when": "scmProvider == git"
        }
      ],
      "commandPalette": [
        {
          "command": "ms365copilot.explainCode",
          "when": "editorIsOpen"
        },
        {
          "command": "ms365copilot.askAboutCode",
          "when": "editorIsOpen"
        },
        {
          "command": "ms365copilot.fixCode",
          "when": "editorIsOpen"
        },
        {
          "command": "ms365copilot.documentCode",
          "when": "editorIsOpen"
        },
        {
          "command": "ms365copilot.generateTests",
          "when": "editorIsOpen"
        },
        {
          "command": "ms365copilot.keepEdits",
          "when": "ms365copilot.hasPendingEdits"
        },
        {
          "command": "ms365copilot.undoEdits",
          "when": "ms365copilot.hasPendingEdits"
        },
        {
          "command": "ms365copilot.showEditDiff",
          "when": "ms365copilot.hasPendingEdits"
        },
        {
          "command": "ms365copilot.discardPendingEdits",
          "when": "ms365copilot.hasPendingEdits"
        },
        {
          "command": "ms365copilot.editCode",
          "when": "editorIsOpen"
        },
        {
          "command": "ms365copilot.previousChange",
          "when": "ms365copilot.hasPendingEdits"
        },
        {
          "command": "ms365copilot.nextChange",
          "when": "ms365copilot.hasPendingEdits"
        },
        {
          "command": "ms365copilot.keepHunk",
          "when": "false"
        },
        {
          "command": "ms365copilot.undoHunk",
          "when": "false"
        }
      ],
      "terminal/context": [
        {
          "command": "ms365copilot.explainTerminal",
          "group": "ms365copilot@1"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "ms365copilot.gettingStarted",
        "title": "%walkthrough.title%",
        "description": "%walkthrough.description%",
        "steps": [
          {
            "id": "ms365copilot.capture",
            "title": "%walkthrough.capture.title%",
            "description": "%walkthrough.capture.description%",
            "media": {
              "image": "imgs/ui-extension-navegador.png",
              "altText": "%walkthrough.capture.alt%"
            }
          },
          {
            "id": "ms365copilot.paste",
            "title": "%walkthrough.paste.title%",
            "description": "%walkthrough.paste.description%",
            "media": {
              "image": "imgs/pegar-token-perfil.png",
              "altText": "%walkthrough.paste.alt%"
            },
            "completionEvents": [
              "onCommand:ms365copilot.pasteProfile"
            ]
          },
          {
            "id": "ms365copilot.chat",
            "title": "%walkthrough.chat.title%",
            "description": "%walkthrough.chat.description%",
            "media": {
              "image": "imgs/modelos-opciones.png",
              "altText": "%walkthrough.chat.alt%"
            },
            "completionEvents": [
              "onCommand:ms365copilot.openChat"
            ]
          },
          {
            "id": "ms365copilot.editor",
            "title": "%walkthrough.editor.title%",
            "description": "%walkthrough.editor.description%",
            "media": {
              "image": "imgs/ejemplo-edicion-codigo.png",
              "altText": "%walkthrough.editor.alt%"
            },
            "completionEvents": [
              "onCommand:ms365copilot.editCode",
              "onCommand:ms365copilot.explainCode",
              "onCommand:ms365copilot.fixCode"
            ]
          },
          {
            "id": "ms365copilot.language",
            "title": "%walkthrough.language.title%",
            "description": "%walkthrough.language.description%",
            "media": {
              "image": "logo/ms365-vscode.png",
              "altText": "%walkthrough.language.alt%"
            },
            "completionEvents": [
              "onCommand:ms365copilot.selectLanguage"
            ]
          }
        ]
      }
    ],
    "keybindings": [
      {
        "command": "ms365copilot.editCode",
        "key": "ctrl+shift+alt+i",
        "mac": "cmd+shift+alt+i",
        "when": "editorTextFocus && !editorReadonly"
      }
    ]
  },
  "scripts": {
    "build": "tsdown && node scripts/build-userscript.mjs",
    "watch": "tsdown --watch",
    "typecheck": "tsc --noEmit && tsc -p userscript/tsconfig.json",
    "lint": "oxlint src tools userscript",
    "test": "node --experimental-strip-types --import ./test/register.mjs test/e2e.mts && node scripts/build-userscript.mjs --check && node --experimental-strip-types --import ./test/register.mjs test/userscript.mts",
    "icon": "node scripts/render-icon.mjs",
    "package": "pnpm build && vsce package --no-dependencies --allow-missing-repository --out ../../releases",
    "vscode:prepublish": "pnpm build",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "dependencies": {
    "@ms365copilot/core": "workspace:*",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.4.1",
    "@types/vscode": "^1.104.0",
    "@types/ws": "^8.18.1",
    "@vscode/vsce": "^3.6.2",
    "oxlint": "^1.81.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2"
  }
}
