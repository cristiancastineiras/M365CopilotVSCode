        "title": "%command.askAboutCode%",
        "category": "M365 Copilot"
      },
      {
        "command": "ms365copilot.fixCode",
        "title": "%command.fixCode%",
        "category": "M365 Copilot"
      },
      {
        "command": "ms365copilot.documentCode",
        "title": "%command.documentCode%",
        "category": "M365 Copilot"
      },
      {
        "command": "ms365copilot.generateTests",
        "title": "%command.generateTests%",
        "category": "M365 Copilot"
      },
      {
        "command": "ms365copilot.generateCommitMessage",
        "title": "%command.generateCommitMessage%",
        "icon": "$(sparkle-filled)"
      },
      {
        "command": "ms365copilot.explainTerminal",
        "title": "%command.explainTerminal%",
        "category": "M365 Copilot",
        "icon": "$(terminal)"
      },
      {
        "command": "ms365copilot.toggleInlineCompletions",
        "title": "%command.toggleInlineCompletions%",
        "category": "M365 Copilot"
      },
      {
        "command": "ms365copilot.pasteProfile",
        "title": "%command.pasteProfile%",
