{
  "name": "ms365-copilot-vscode",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "2.0.0",
  "publisher": "ms365-copilot-vscode",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cristiancastineiras/M365CopilotVSCode.git",
    "directory": "extensiones/vscode"
  },
  "icon": "logo/ms365-vscode.png",
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "main": "./dist/extension.cjs",
  "type": "module",
  "activationEvents": [
    "onStartupFinished",
    "onLanguageModelChatProvider:ms365copilot"
  ],
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "ms365copilot",
        "displayName": "Microsoft 365 Copilot"
      }
    ],
    "languageModelTools": [
      {
        "name": "ms365_list_files",
        "displayName": "%tool.ms365ListFiles.displayName%",
        "modelDescription": "List files below a workspace-relative directory without reading their contents. Use it first to discover the project layout before reading or editing files.",
        "userDescription": "%tool.ms365ListFiles.userDescription%",
        "toolReferenceName": "ms365ListFiles",
        "canBeReferencedInPrompt": true,
        "icon": "$(list-tree)",
        "when": "workspaceFolderCount != 0",
        "tags": [
          "ms365copilot"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "Optional workspace-relative directory."
            },
            "maxEntries": {
              "type": "integer",
              "minimum": 1,
              "maximum": 250
            },
            "workspaceFolder": {
              "type": "string",
              "description": "Required only for multi-root workspaces."
            }
          }
        }
      },
      {
        "name": "ms365_search_text",
        "displayName": "%tool.ms365SearchText.displayName%",
        "modelDescription": "Search for literal text across a bounded set of workspace files and return concise file:line matches. Use it to locate code before reading or editing it.",
        "userDescription": "%tool.ms365SearchText.userDescription%",
        "toolReferenceName": "ms365SearchText",
        "canBeReferencedInPrompt": true,
        "icon": "$(search)",
        "when": "workspaceFolderCount != 0",
        "tags": [
          "ms365copilot"
        ],
        "inputSchema": {
          "type": "object",
          "required": [
            "query"
          ],
          "properties": {
            "query": {
              "type": "string",
              "description": "Literal text to search for."
            },
            "path": {
              "type": "string",
              "description": "Optional workspace-relative directory."
            },
            "maxResults": {
              "type": "integer",
              "minimum": 1,
              "maximum": 80
            },
            "caseSensitive": {
              "type": "boolean",
              "description": "Match case exactly. Defaults to false."
            },
            "workspaceFolder": {
              "type": "string",
              "description": "Required only for multi-root workspaces."
            }
          }
        }
      },
      {
        "name": "ms365_read_file",
        "displayName": "%tool.ms365ReadFile.displayName%",
        "modelDescription": "Read a small, line-numbered range from a workspace-relative text file. Always read the relevant range with this tool before proposing edits to a file.",
        "userDescription": "%tool.ms365ReadFile.userDescription%",
        "toolReferenceName": "ms365ReadFile",
        "canBeReferencedInPrompt": true,
        "icon": "$(file-code)",
        "when": "workspaceFolderCount != 0",
        "tags": [
          "ms365copilot"
        ],
        "inputSchema": {
          "type": "object",
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string",
              "description": "Workspace-relative file path."
            },
            "startLine": {
              "type": "integer",
              "minimum": 1
            },
            "endLine": {
              "type": "integer",
              "minimum": 1
            },
            "workspaceFolder": {
              "type": "string",
              "description": "Required only for multi-root workspaces."
            }
          }
        }
      },
      {
        "name": "ms365_apply_edits",
        "displayName": "%tool.ms365ApplyEdits.displayName%",
        "modelDescription": "Apply a reversible batch of exact workspace edits. Changes land in the editor immediately (unsaved), highlighted, with Keep/Undo actions on the change for the user to accept or revert — so never assume they are final. Fields per operation: replace needs oldText (exact and unique in the file) plus newText; create needs content (NOT newText); delete needs only path. Prefer several small calls over one huge batch when creating many files.",
        "userDescription": "%tool.ms365ApplyEdits.userDescription%",
        "toolReferenceName": "ms365ApplyEdits",
        "canBeReferencedInPrompt": true,
        "icon": "$(edit)",
        "when": "workspaceFolderCount != 0",
        "tags": [
          "ms365copilot"
        ],
        "inputSchema": {
          "type": "object",
          "required": [
            "edits"
          ],
          "properties": {
            "edits": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "items": {
                "type": "object",
                "required": [
                  "operation",
                  "path"
                ],
                "properties": {
                  "operation": {
                    "type": "string",
                    "enum": [
                      "replace",
                      "create",
                      "delete"
                    ]
                  },
                  "path": {
                    "type": "string",
                    "description": "Workspace-relative file path."
                  },
                  "oldText": {
                    "type": "string",
                    "description": "Required exact, unique text for replace."
                  },
                  "newText": {
                    "type": "string",
                    "description": "Replacement text for replace."
                  },
                  "content": {
                    "type": "string",
                    "description": "Initial content for create."
                  },
                  "workspaceFolder": {
                    "type": "string",
                    "description": "Required only for multi-root workspaces."
                  }
                }
              }
            }
          }
        }
      },
      {
        "name": "ms365_get_diagnostics",
        "displayName": "%tool.ms365GetDiagnostics.displayName%",
        "modelDescription": "Read the errors and warnings VS Code's language server already computed for a file or the whole workspace. Read-only; does not compile or run anything. Use it after proposing edits to check they didn't introduce new errors.",
        "userDescription": "%tool.ms365GetDiagnostics.userDescription%",
        "toolReferenceName": "ms365GetDiagnostics",
        "canBeReferencedInPrompt": true,
        "icon": "$(warning)",
        "when": "workspaceFolderCount != 0",
        "tags": [
          "ms365copilot"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "Optional workspace-relative file. Omit for the whole workspace."
            },
            "severity": {
              "type": "string",
              "enum": [
                "error",
                "warning",
                "all"
              ],
              "description": "Minimum severity to include. Defaults to all."
            },
            "workspaceFolder": {
              "type": "string",
              "description": "Required only for multi-root workspaces."
            }
          }
        }
      },
      {
        "name": "ms365_git_info",
        "displayName": "%tool.ms365GitInfo.displayName%",
        "modelDescription": "Read-only git status, diff or log for the workspace or a path. Never commits, pushes or otherwise modifies the repository.",
        "userDescription": "%tool.ms365GitInfo.userDescription%",
        "toolReferenceName": "ms365GitInfo",
        "canBeReferencedInPrompt": true,
        "icon": "$(git-branch)",
        "when": "workspaceFolderCount != 0",
        "tags": [
          "ms365copilot"
        ],
        "inputSchema": {
          "type": "object",
          "required": [
            "action"
          ],
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "status",
                "diff",
                "log"
              ]
            },
            "path": {
              "type": "string",
              "description": "Optional workspace-relative path to scope the command to."
            },
            "staged": {
              "type": "boolean",
              "description": "For action=diff: show staged changes instead of the working tree."
            },
            "maxCount": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "description": "For action=log: how many commits (default 20)."
            },
            "workspaceFolder": {
              "type": "string",
              "description": "Required only for multi-root workspaces."
            }
          }
        }
      },
      {
        "name": "ms365_generate_commit_message",
        "displayName": "%tool.ms365GenerateCommitMessage.displayName%",
        "modelDescription": "Trigger VS Code's native Source Control 'Generate Commit Message' feature for the workspace repository and return what it produced, together with the staged (or working tree) diff. Does not modify the repository. Review/fix the result so its first line follows Conventional Commits before passing it to ms365_git_commit.",
        "userDescription": "%tool.ms365GenerateCommitMessage.userDescription%",
        "toolReferenceName": "ms365GenerateCommitMessage",
        "canBeReferencedInPrompt": true,
        "icon": "$(sparkle)",
        "when": "workspaceFolderCount != 0",
        "tags": [
          "ms365copilot"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "workspaceFolder": {
              "type": "string",
              "description": "Required only for multi-root workspaces."
            }
          }
        }
      },
      {
        "name": "ms365_git_commit",
        "displayName": "%tool.ms365GitCommit.displayName%",
        "modelDescription": "Create a real commit with the given message, validated as Conventional Commits ('type(scope): summary'). Only commits what is already staged unless stageAll (git add -A) or paths (git add of those paths) is given. Requires explicit user confirmation showing the exact message before it runs.",
        "userDescription": "%tool.ms365GitCommit.userDescription%",
        "toolReferenceName": "ms365GitCommit",
        "canBeReferencedInPrompt": true,
        "icon": "$(git-commit)",
        "when": "workspaceFolderCount != 0",
        "tags": [
          "ms365copilot"
        ],
        "inputSchema": {
          "type": "object",
          "required": [
            "message"
          ],
          "properties": {
            "message": {
              "type": "string",
              "description": "Commit message. First line must follow Conventional Commits: type(scope): summary."
            },
            "stageAll": {
              "type": "boolean",
              "description": "Run git add -A before committing. Takes priority over paths."
            },
            "paths": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 50,
              "description": "Workspace-relative paths to git add before committing."
            },
            "workspaceFolder": {
              "type": "string",
              "description": "Required only for multi-root workspaces."
            }
          }
        }
      },
      {
        "name": "ms365_run_command",
        "displayName": "%tool.ms365RunCommand.displayName%",
        "modelDescription": "Run a shell command in the workspace and return its output (stdout/stderr, exit code). Requires explicit user confirmation before it executes. Use for builds, tests and other checks — not for destructive or irreversible actions unless the user explicitly asked for them.",
        "userDescription": "%tool.ms365RunCommand.userDescription%",
        "toolReferenceName": "ms365RunCommand",
        "canBeReferencedInPrompt": true,
        "icon": "$(terminal)",
        "when": "workspaceFolderCount != 0",
        "tags": [
          "ms365copilot"
        ],
        "inputSchema": {
          "type": "object",
          "required": [
            "command"
          ],
          "properties": {
            "command": {
              "type": "string",
              "description": "The shell command to run."
            },
            "cwd": {
              "type": "string",
              "description": "Optional workspace-relative working directory."
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300,
              "description": "Kill the command after this many seconds (default 60)."
            },
            "workspaceFolder": {
              "type": "string",
              "description": "Required only for multi-root workspaces."
            }
          }
        }
      },
      {
        "name": "ms365_spawn_agents",
        "displayName": "%tool.ms365SpawnAgents.displayName%",
        "modelDescription": "Delegate one or more concrete, independent tasks (exploration, analysis, or even scoped edits/commands) to autonomous M365 Copilot sub-agents that run their own tool loop — in parallel when there are several — with the same workspace tools as the main agent (list/search/read/diagnostics/read-only git, and also proposing edits, running commands or committing if the task needs it, with the same Keep/Undo review and confirmation as always). Each sub-agent only sees the task it is given, not the rest of the conversation, and returns a concise summary — so exploring broadly does not fill up your own context. Use it for independent questions that can be investigated in parallel, broad exploration before deciding a change, or scoped tasks that do not need step-by-step supervision. Describe each task self-contained: the sub-agent has no access to the conversation history.",
        "userDescription": "%tool.ms365SpawnAgents.userDescription%",
        "toolReferenceName": "ms365SpawnAgents",
        "canBeReferencedInPrompt": true,
        "icon": "$(run-all)",
        "when": "workspaceFolderCount != 0",
        "tags": [
          "ms365copilot"
        ],
        "inputSchema": {
          "type": "object",
          "required": [
            "tasks"
          ],
          "properties": {
            "tasks": {
              "type": "array",
              "minItems": 1,
              "maxItems": 6,
              "items": {
                "type": "object",
                "required": [
                  "task"
                ],
                "properties": {
                  "task": {
                    "type": "string",
                    "description": "Self-contained description of what the sub-agent must do and return — it cannot see the rest of the conversation."
                  },
                  "label": {
                    "type": "string",
                    "description": "Optional short label to identify this task in the combined report."
                  }
                }
              }
            }
          }
        }
      }
    ],
    "configuration": {
      "title": "M365 Copilot",
      "properties": {
        "ms365copilot.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "es"
          ],
          "enumDescriptions": [
            "%config.language.auto%",
            "%config.language.en%",
            "%config.language.es%"
          ],
          "default": "auto",
          "scope": "application",
          "markdownDescription": "%config.language%"
        },
        "ms365copilot.notifications.tokenExpiry": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.notifications.tokenExpiry%"
        },
        "ms365copilot.editor.codeActions": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.editor.codeActions%"
        },
        "ms365copilot.editor.model": {
          "type": "string",
          "enum": [
            "ms365-copilot-auto",
            "ms365-copilot-gpt",
            "ms365-copilot-gpt56",
            "ms365-copilot-gpt56-reasoning",
            "ms365-copilot-claude",
            "ms365-copilot-reasoning"
          ],
          "default": "ms365-copilot-auto",
          "markdownDescription": "%config.editor.model%"
        },
        "ms365copilot.terminal.captureOutput": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.terminal.captureOutput%"
        },
        "ms365copilot.tools.includeEditorTools": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.tools.includeEditorTools%"
        },
        "ms365copilot.tools.duplicates": {
          "type": "string",
          "enum": [
            "preferEditor",
            "preferM365",
            "both"
          ],
          "enumDescriptions": [
            "%config.tools.duplicates.preferEditor%",
            "%config.tools.duplicates.preferM365%",
            "%config.tools.duplicates.both%"
          ],
          "default": "preferEditor",
          "markdownDescription": "%config.tools.duplicates%"
        },
        "ms365copilot.tools.maxAdvertised": {
          "type": "number",
          "default": 48,
          "minimum": 4,
          "maximum": 200,
          "markdownDescription": "%config.tools.maxAdvertised%"
        },
        "ms365copilot.models.updateFromCatalog": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.models.updateFromCatalog%"
        },
        "ms365copilot.models.detectFromBrowser": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.models.detectFromBrowser%"
        },
        "ms365copilot.models.custom": {
          "type": "array",
          "default": [],
          "items": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.-]{1,63}$"
              },
              {
                "type": "object",
                "required": [
                  "tone"
                ],
                "properties": {
                  "tone": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_.-]{1,63}$"
                  },
                  "name": {
                    "type": "string"
                  }
                }
              }
            ]
          },
          "markdownDescription": "%config.models.custom%"
        },
        "ms365copilot.subagents.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.subagents.enabled%"
        },
        "ms365copilot.subagents.maxConcurrent": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 6,
          "markdownDescription": "%config.subagents.maxConcurrent%"
        },
        "ms365copilot.subagents.maxSteps": {
          "type": "number",
          "default": 6,
          "minimum": 1,
          "maximum": 12,
          "markdownDescription": "%config.subagents.maxSteps%"
        },
        "ms365copilot.subagents.model": {
          "type": "string",
          "enum": [
            "ms365-copilot-auto",
            "ms365-copilot-gpt",
            "ms365-copilot-gpt56",
            "ms365-copilot-gpt56-reasoning",
            "ms365-copilot-claude",
            "ms365-copilot-reasoning"
          ],
          "default": "ms365-copilot-auto",
          "description": "%config.subagents.model%"
        },
        "ms365copilot.inlineCompletions.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.inlineCompletions.enabled%"
        },
        "ms365copilot.inlineCompletions.triggerMode": {
          "type": "string",
          "enum": [
            "automatic",
            "manual"
          ],
          "enumDescriptions": [
            "%config.inlineCompletions.triggerMode.automatic%",
            "%config.inlineCompletions.triggerMode.manual%"
          ],
          "default": "automatic",
          "description": "%config.inlineCompletions.triggerMode%"
        },
        "ms365copilot.inlineCompletions.debounceMs": {
          "type": "number",
          "default": 500,
          "minimum": 0,
          "maximum": 5000,
          "description": "%config.inlineCompletions.debounceMs%"
        },
        "ms365copilot.inlineCompletions.maxLines": {
          "type": "number",
          "default": 6,
          "minimum": 1,
          "maximum": 30,
          "description": "%config.inlineCompletions.maxLines%"
        },
        "ms365copilot.inlineCompletions.timeoutMs": {
          "type": "number",
          "default": 6000,
          "minimum": 1000,
          "maximum": 30000,
          "description": "%config.inlineCompletions.timeoutMs%"
        },
        "ms365copilot.inlineCompletions.model": {
          "type": "string",
          "enum": [
            "ms365-copilot-auto",
            "ms365-copilot-gpt",
            "ms365-copilot-gpt56",
            "ms365-copilot-gpt56-reasoning",
            "ms365-copilot-claude",
            "ms365-copilot-reasoning"
          ],
          "default": "ms365-copilot-auto",
          "description": "%config.inlineCompletions.model%"
        },
        "ms365copilot.inlineCompletions.disabledLanguages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "scminput",
            "plaintext"
          ],
          "markdownDescription": "%config.inlineCompletions.disabledLanguages%"
        }
      }
    },
    "commands": [
      {
        "command": "ms365copilot.showMenu",
        "title": "%command.showMenu%",
        "category": "M365 Copilot",
        "icon": "$(sparkle)"
      },
      {
        "command": "ms365copilot.openChat",
        "title": "%command.openChat%",
        "category": "M365 Copilot",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "ms365copilot.editCode",
        "title": "%command.editCode%",
        "category": "M365 Copilot",
        "icon": "$(wand)"
      },
      {
        "command": "ms365copilot.explainCode",
        "title": "%command.explainCode%",
        "category": "M365 Copilot"
      },
      {
