{
  "name": "@m365copilot/tui",
  "version": "3.0.2",
  "private": true,
  "description": "M365 Copilot en el terminal: un programa independiente con su propio cliente del protocolo BizChat; sólo necesita Node.",
  "type": "module",
  "engines": {
    "node": ">=26.4.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint src scripts",
    "start": "node --experimental-ffi dist/m365-copilot-tui.mjs"
  },
  "dependencies": {
    "@m365copilot/core": "workspace:*",
    "@opentui/core": "^0.6.6",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "oxlint": "^1.87.0",
    "tsdown": "^0.23.0",
    "typescript": "^5.6.2"
  }
}
